{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NioCM",
  "version": "0.3.1",
  "identifier": "com.nio-labs.niocm",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "NioCM",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "nsis", "deb", "appimage"],
    "externalBin": ["binaries/niocm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "NioCM — The Agentic Terminal",
    "longDescription": "Desktop terminal multiplexer for AI coding agents, powered by NioAI.",
    "publisher": "Nio Labs",
    "copyright": "Copyright © 2026 Nio Labs",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
